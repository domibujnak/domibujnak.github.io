---
import Header from "../components/Header.astro";

const { title = "Dominika Bujnáková"} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>

	<style>
  :global(*) {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    font-family: "Inter", Arial, sans-serif;
    color: #222;
    background: #fafafa;
  }

:global(header) {
  background: white;
  border-bottom: 1px solid #e8e8e8;
  position: sticky;
  top: 0;
  z-index: 1000;

  display: flex;
  align-items: center;
  justify-content: space-between;

padding: 1.25rem max(2rem, calc((100vw - 1300px) / 2));}

:global(nav) {
  display: flex;
  gap: 2.5rem;
  align-items: center;
}

:global(nav a) {
  color: #222;
  text-decoration: none;
  font-weight: 500;
  letter-spacing: 0.03em;
  transition: color 0.2s ease;
}

:global(.logo) {
  text-decoration: none;
  color: #222;
  font-size: 1.2rem;
  font-weight: 600;
  letter-spacing: 0.02em;
}

:global(nav a:hover) {
  color: #666;
}

  main {
  max-width: 1100px;
  margin: 0 auto;
  padding: 4rem 3rem;
}

  section {
    margin-bottom: 4rem;
  }
</style>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet" />


  </head>

  <body>
  <Header />
  <slot />
</body>
</html>