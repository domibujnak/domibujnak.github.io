---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Dominika Bujnáková">
 
    <section class="hero">
  <div class="hero-content">
    <h1>Dominika Bujnáková</h1>
<p>Wildlife Biologist · Conservation Scientist · Photographer</p>
  </div>
</section>

 <main>



    <section>
      

      <div>
        <a href="/research" class="card">
  			<img src="/images/research.webp" alt="Research" />

  		<div class="card-content">
    	  <h3>Research</h3>
    	  <p>Scientific projects, publications, and fieldwork.</p>
  		  </div>
		</a>

        <a href="/outreach" class="card">
  		<img src="/images/outreach.webp" alt="Outreach" />

 			 <div class="card-content">
   			 <h3>Outreach</h3>
    		<p>Sharing science with wider audiences.</p>
 			 </div>
		</a>

        <a href="/photography" class="card">
  		<img src="/images/photography.webp" alt="Photography" />

  		<div class="card-content">
    		<h3>Photography</h3>
   		 <p>Wildlife stories through images.</p>
  		</div>
		</a>
      </div>
    </section>



	
  </main>
</Layout>

<style>
.hero {
  min-height: 70vh;
  display: flex;
  align-items: center;
padding: 4rem max(2rem, calc((100vw - 1300px) / 2));  background-image:
    linear-gradient(rgba(0,0,0,0.30), rgba(0,0,0,0.30)),
    url('/images/hero1.webp');
  background-size: cover;
  background-position: center;
  color: white;
}

 .hero h1 {
  font-size: 3.5rem;
  max-width: 800px;
  margin-bottom: 0.8rem;
  letter-spacing: -0.02em;
}

.hero p {
  font-size: 1.25rem;
  max-width: 600px;
  letter-spacing: 0.03em;
}

 .hero-content {
  max-width: 1100px;
  margin: 0 auto;
  width: 100%;
}

.intro {
  max-width: 900px;
  margin: 0 auto 5rem;
}

.intro p {
  font-size: 1.15rem;
  line-height: 1.8;
  color: #444;
  margin-bottom: 1.5rem;
}
</style>



<style>
  section:not(.hero) > div {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;

  max-width: 1300px;
  margin: 0 auto;
}

section:not(.hero) {
  margin-top: 4rem;
}

  section a {
  background: white;
  border-radius: 12px;
  overflow: hidden;
  border: 1px solid #ddd;
  text-decoration: none;
  color: inherit;
  transition: transform 0.2s ease;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .hero + section a:hover {
    transform: translateY(-5px);
  }



  .card img {
  width: 100%;
  height: 220px;
  object-fit: cover;
  display: block;
}

.card img {
  transition: transform 0.5s ease;
}

.card:hover img {
  transform: scale(1.05);
}

.card-content {
  padding: 2rem;
}


@media (max-width: 900px) {
  section:not(.hero) > div {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
}
</style>