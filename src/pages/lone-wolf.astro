<style>

.hero{
  min-height:55vh;
  display:flex;
  align-items:center;

  padding:4rem max(2rem, calc((100vw - 1300px)/2));

  background:
    linear-gradient(rgba(0,0,0,.35), rgba(0,0,0,.35)),
    url("/images/lone-wolf-hero.webp");

  background-size:cover;
  background-position:center;
  color:white;
}

.hero-content{
  max-width:900px;
}

.hero h1{
  font-size:4rem;
  margin-bottom:1rem;
}

.hero p{
  font-size:1.3rem;
  line-height:1.6;
}

main{
  max-width:1100px;
  margin:0 auto;
  padding:4rem 2rem;
}

section{
  margin-bottom:3rem;
}

h2{
  font-size:2rem;
  margin-bottom:1.5rem;
}

p{
  line-height:1.8;
  font-size:1.05rem;
}

.intro{
  max-width:800px;
  margin:0 auto 4rem;
  text-align:left;
}

.feature{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:4rem;
  align-items:center;
}

.feature.reverse img{
  order:2;
}

.feature.reverse div{
  order:1;
}

.feature img{
  width:100%;
  border-radius:18px;
  object-fit:cover;
}

.research{
  max-width:800px;
  margin:0 auto 1rem;
}

.timeline-grid{

  display:grid;
  grid-template-columns:repeat(4,1fr);

  gap:1.5rem;

  margin-top:1rem;

}

.event{

  background:#fafafa;

  border:1px solid #e6e6e6;

  border-radius:16px;

  padding:1.5rem;

}

.event h3{

  color:#2d5a3d;

  margin-top:0;

  margin-bottom:.8rem;

}


.gallery{

  max-width:1100px;

  margin:0 auto 3rem;

}

.gallery-header{

  margin-bottom:2rem;

}

.gallery-grid{

  display:grid;
  grid-template-columns:repeat(2,1fr);

  gap:1.5rem;

  margin-top:2rem;

}



.gallery-grid img{

  width:100%;

  aspect-ratio:4/3;

  object-fit:cover;

  border-radius:16px;

  transition:.3s;

}

.gallery-grid img:hover{

  transform:scale(1.02);

}

.section-intro{
  margin-bottom:1rem;
}

.credits{

  max-width:800px;

  margin:auto;

}

.credits-grid{

  display:grid;

  grid-template-columns:1fr 1fr;

  gap:3rem;

  margin:2rem 0;

}

.credits h3{

  margin-bottom:.5rem;

  color:#2d5a3d;

}

.contact{

  text-align:center;

  max-width:800px;

  margin:auto;

  background:#f8faf8;

  padding:3rem;

  border-radius:20px;

}

.contact strong{

  color:#2d5a3d;

}

@media(max-width:900px){

  .feature{
    grid-template-columns:1fr;
  }

  .feature.reverse img,
  .feature.reverse div{
    order:initial;
  }

  .timeline-grid{
    grid-template-columns:1fr;
  }

  .gallery-grid{
    grid-template-columns:1fr;
  }

  .credits-grid{
    grid-template-columns:1fr;
  }

  .hero h1{
    font-size:3rem;
  }

}


.download{

  max-width:800px;

  margin:1rem auto;

  background:#f8faf8;

  border-radius:18px;

  padding:1rem;

  text-align:left;

}

.impact{

  max-width:800px;

  margin:1rem auto 2rem;

  background:#f8faf8;

  border-radius:18px;

  padding:1rem;

  text-align:left;

}

.download-button{

  display:inline-block;

  margin-top:1.5rem;

  padding:1rem 2rem;

  background:#2d5a3d;

  color:white;

  text-decoration:none;

  border-radius:999px;

  font-weight:600;

  transition:.25s;

}

.download-button:hover{

  background:#21412c;

  transform:translateY(-2px);

}

.photo-note {
  margin-top: 1rem;
  font-size: 0.85rem;
  color: #888;
}
</style>