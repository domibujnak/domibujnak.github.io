---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Outreach">

<main>

<section class="hero">

  <div class="hero-content">
    <h1>Outreach</h1>

    <p>
      Connecting wildlife science with society through education,
      communication, and creative approaches.
    </p>
  </div>

</section>


<section class="outreach-grid">

<a href="/lone-wolf" class="card">

  <img src="/images/lone-wolf.webp" alt="Lone Wolf" />

  <div class="card-content">

    <h2>Lone Wolf Board Game</h2>
<p>
Developed from scientific research, Lone Wolf uses storytelling 
and gameplay to inspire curiosity about wildlife and conservation. 
The game helps young audiences understand the ecological role of 
wolves and promotes coexistence with nature.
</p>

</div>

</a>


<a href="/research-exhibition" class="card">

  <img
    src="/images/exhibition.webp"
    alt="Research exhibition"
  />

  <div class="card-content">

    <h2>Research Exhibition</h2>

    <p>
      Living World from Different Perspectives is a public exhibition 
      showcasing research from the Ecology and Genetics Research Unit
      at the University of Oulu, Finland. Through photography and 
      accessible stories, the exhibition invites visitors to discover 
      how researchers study wildlife, why these species matter, and 
      how scientific research contributes to understanding and 
      conserving the natural world.
    </p>

  </div>


</a>




</section>


</main>


</Layout>


<style>

.hero {

min-height:45vh;

display:flex;
align-items:center;

padding:4rem max(2rem, calc((100vw - 1300px)/2));

background-image:
linear-gradient(
rgba(0,0,0,.35),
rgba(0,0,0,.35)
),
url("/images/outreachmain-hero.webp");

background-size:cover;
background-position:center;

color:white;

}


.hero-content{

max-width:700px;

}


.hero h1{

font-size:3.5rem;

}


.hero p{

font-size:1.3rem;
line-height:1.6;

}


.outreach-grid{
  max-width:1100px;
  margin:4rem auto;
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:2rem;
}

.card{

background:white;

border-radius:16px;

overflow:hidden;

box-shadow:0 10px 30px rgba(0,0,0,.08);
display:block;

text-decoration:none;

color:inherit;

}

.card:visited{
  color:inherit;
}

.card:hover{
  transform: translateY(-4px);
  box-shadow:0 16px 36px rgba(0,0,0,.12);
}

.card img{

width:100%;
height:220px;

object-fit:cover;

}



.card-content{

padding:1.5rem;

}



.card h2{

margin-top:0;

}



.card p{

line-height:1.7;

}



@media(max-width:900px){

.outreach-grid{

grid-template-columns:1fr;

}

}

</style>