---
import Layout from "../../layouts/Layout.astro";

---

<Layout title="Finland">

  <section class="hero">
    <div class="hero-content">
      <h1>Finland</h1>
    </div>
  </section>

  <main>

    <!-- Categories -->

    <section class="categories">

      <h2>Gallery</h2>

      <div class="cards">

        <a href="/photography/finland/finnish_mammals" class="card">
          <img
            src="/photographs/photo-finnish_mammals.webp"
            alt="Mammals"
          />
          <div class="card-content">
            <h3>Mammals</h3>
          </div>
        </a>

        <a href="/photography/finland/finnish_birds" class="card">
          <img
            src="/photographs/photo-finnish_birds.webp"
            alt="Birds"
          />
          <div class="card-content">
            <h3>Birds</h3>
          </div>
        </a>

        <a href="/photography/finland/finnish_nature" class="card">
          <img
            src="/photographs/photo-finnish_nature.webp"
            alt="Nature"
          />
          <div class="card-content">
            <h3>Nature</h3>
          </div>
        </a>

      </div>

    </section>


<footer class="photo-copyright">
  © 2026 Dominika Bujnáková. All photographs are copyrighted and may not be
  reproduced, distributed, or used without permission.
</footer>



  </main>

</Layout>


<style>

.hero {
  display: flex;
  align-items: center;
  padding: 4rem max(2rem, calc((100vw - 1300px) / 2));
  color: #f2f2f2;
}

.hero-content {
  max-width: 700px;
}

.hero h1 {
  font-size: 4rem;
  margin: 0;
}

main {
  max-width: 1300px;
  margin: auto;
  padding: 2rem;
}

section {
  margin-bottom: 3rem;
}


/* Categories */

.categories h2 {
  margin-bottom: 2rem;
}

.cards {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 2rem;
}

.card {
  background: transparent;
  border-radius: 0;
  overflow: hidden;
  text-decoration: none;
  color: inherit;
  transition: 0.25s;
}

.card:hover {
  box-shadow: 0 18px 40px rgba(0, 0, 0, 0.12);
}

.card img {
  width: 100%;
  height: 350px;
  object-fit: cover;
  display: block;
}

.card-content {
  padding: 1.5rem;
}

.card-content h3 {
  margin: 0;
  color: #f2f2f2;
  text-align: center;
}


/* Gallery */

.gallery {
  margin-top: 4rem;
}

.gallery-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 5rem;
}

.gallery-grid img {
  width: auto;
  max-width: 100%;
  max-height: 85vh;
  height: auto;
  display: block;
  margin: 0 auto;
}


/* Mobile */

@media (max-width: 900px) {

  .cards {
    grid-template-columns: 1fr;
  }

  .hero h1 {
    font-size: 3rem;
  }

  .gallery-grid {
    gap: 3rem;
  }

}

body {
  background: #1b1b1b;
  color: #f2f2f2;
}

.photo-copyright {
  margin-top: 2rem;
  padding: 2rem 0;
  text-align: center;
  font-size: 0.85rem;
  color: #888;
}

</style>