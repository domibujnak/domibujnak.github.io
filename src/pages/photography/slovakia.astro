---
import Layout from "../../layouts/Layout.astro";

import { Image } from "astro:assets";

const photos = Object.values(
  import.meta.glob("../../assets/photographs/slovakia/*.{webp,JPG,jpg,jpeg,png}", {
    eager: true,
  })
  ).sort((a, b) =>
  b.default.src.localeCompare(a.default.src, undefined, { numeric: true })
);
---

<Layout title="Slovakia">

<section class="hero">

  <div class="hero-content">

    <h1>Slovakia</h1>

   
   

  </div>

</section>

<main>



<section class="gallery">

<div class="gallery-grid">

{photos.map((photo) => (

  <img
    src={photo.default.src}
    alt=""
    loading="lazy"
  />

))}

</div>
</section>


<footer class="photo-copyright">
  © 2026 Dominika Bujnáková. All photographs are copyrighted and may not be
  reproduced, distributed, or used without permission.
</footer>



</main>

</Layout>

<style>

.hero{
  display:flex;
  align-items:center;
  padding:1rem max(2rem, calc((100vw - 1300px)/2));
  background-size:cover;
  background-position:center;
  color:white;
}

.hero-content{
  max-width:800px;
}

.hero h1{
  font-size:3rem;
}

.hero p{
  font-size:1.3rem;
}

main{
  max-width:1500px;
  margin:auto;
  padding:2rem 2rem;
}

.intro{
  max-width:800px;
  margin:0 auto 5rem;
}

.intro p{
  line-height:1.8;
  font-size:1.05rem;
}

.gallery-grid{
  display:grid;
    columns:1;
  column-gap:2rem;
  grid-template-columns:repeat(1, 1fr);
  gap:5rem;
}
@media (max-width:900px){
  .gallery-grid{
    grid-template-columns:1fr;
  }
}

.gallery-grid img{
  width:auto;
  max-width:100%;
  max-height:85vh;
  height:auto;
  display:block;
  margin:0 auto;
}

.thumb :global(img){
  width:100%;
  height:100%;
  object-fit:cover;
}

body{
    background:#1b1b1b;
    color:#f2f2f2;
}


.photo-copyright {
  margin-top: 2rem;
  padding: 2rem 0;
  text-align: center;
  font-size: 0.85rem;
  color: #888;
}
</style>
</Layout>
